{
  "name": "@thaz/form-util",
  "version": "1.0.0-rc.1",
  "description": "Set of form validation utilities for applications and libraries in the thaz collective namespace",
  "keywords": [
    "date",
    "form",
    "temporal",
    "valibot",
    "validation"
  ],
  "homepage": "https://github.com/thaz-collective/form-util#readme",
  "bugs": {
    "url": "https://github.com/thaz-collective/form-util/issues"
  },
  "license": "MIT",
  "author": "Tim Hazlett",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaz-collective/form-util.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./valibot": {
      "types": "./dist/valibot.d.mts",
      "import": "./dist/valibot.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "playwright:setup": "vpx playwright install chromium chromium-headless-shell firefox",
    "prepack": "vp run build",
    "taze": "vpx taze@latest -Ilwr --maturity-period 3",
    "taze:major": "vpx taze@latest major -Ilwr --maturity-period 3",
    "taze:minor": "vpx taze@latest minor -Ilwr --maturity-period 3",
    "taze:patch": "vpx taze@latest patch -Ilwr --maturity-period 3"
  },
  "devDependencies": {
    "@internationalized/date": "catalog:",
    "@js-temporal/polyfill": "catalog:",
    "@thaz/oxfmt-config": "catalog:",
    "@thaz/oxlint-config": "catalog:",
    "@thaz/temporal-util": "catalog:",
    "@thaz/typescript-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@thaz/temporal-util": "^1.0.0-rc.1",
    "react": "^19.2.7",
    "valibot": "^1.4.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
